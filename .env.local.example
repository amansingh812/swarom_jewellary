# ───────────────────────────────────────────────────────────
# Swarom — environment variables
# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local` — it's in .gitignore.
# ───────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────
# Get these from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-only key for admin / webhook operations.
# Never expose this in client code (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ─── Razorpay (added in Phase 1.5 — checkout) ────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── WhatsApp Business (added later for order updates) ────
WHATSAPP_BUSINESS_NUMBER=919999999999

# ─── Site config ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
